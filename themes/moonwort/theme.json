      },
      "rules": {
        "goal": {
          "p": "Rival potion-makers race to {end} {{mon}}. Every patient is a small map: cure them by playing ingredient cards that move your marker from the start ◯ to the cure {cure}."
        },
        "brew": {
          "p": "Pick a patient (tap it, or swipe the map), then tap a card to preview its move. Play it, or cancel and try another. Tap a numbered chip to go back to that card. Each element moves in a straight line its own way: {dirs}, exactly as many squares as its card shows. A card with two elements moves diagonally between their ways. A Wishing Star {kitsune} moves one square any way, diagonals too. Straight moves can't pass through a jinx {oniG}; diagonals slip past. Nothing may land on a jinx or leave the map. Finish <b>exactly</b> on {cure}, using at least {min} hand card. Hand cards are spent; greenhouse cards stay."
        },
        "fame": {
          "p": "A cured patient is worth its number in {{mon}}. Passing a star {sakura} adds {sak}."
        },
        "curse": {
          "p": "After a cure you may spend one of your {oni} jinx cards to hex an infirmary patient's map. The cure, the jinxes and the start move; ingredient directions and the patient's element don't, so the cure may now lie against the element it needs. A hexed patient can't be hexed again.",
          "h": "Hexes"
        },
        "end": {
          "h": "Greenhouse, hand, end",
          "p": "The greenhouse holds {garden}; planting into a full greenhouse discards one. Hand limit {hand} at the end of your turn. When someone reaches {end}, the round finishes so both play equally; it also ends after the infirmary empties. Most {{mon}} wins; ties go to most cures."
        },
        "guild": {
          "h": "Houses",
          "p": "Your house has an element. Once per brew you may play one greenhouse card of that element twice, so plant those."
        },
        "brewClassic": {
          "p": "Pick a patient (tap it, or swipe the map), then tap a card to preview its path. Play it, or cancel and try another. Tap a numbered chip to go back to that card. Paths go: {dirs}; a Wishing Star {kitsune} is one step any way. The signs in a card's corner show every direction its path takes. Order matters. Paths can't enter a jinx {oniG} square or leave the map. Finish <b>exactly</b> on {cure}, using at least {min} hand card. Hand cards are spent; greenhouse cards stay."
        }
      },
      "abilities": {
        "green": {
          "text": "Your greenhouse holds one more card and starts with two in it."
        },
        "trickster": {
          "name": "Hexcraft",
          "text": "Two extra jinx cards, and one more card to start."
        },
        "forager": {
