      "status": {
        "needElWhy": "Lucky Cat counts as any element"
      },
      "rules": {
        "needEl": "A cure needs at least one ingredient of the patient's element (the big sign in a card's corner). The Lucky Cat {kitsune} counts as any element. A two-element card counts as either.",
        "brew": {
          "p": "Pick a patient (tap it, or swipe the map), then tap a card to preview its move. Play it, or cancel and try another. Tap a numbered chip to go back to that card. Each element moves in a straight line its own way: {dirs}, exactly as many squares as its card shows. A card with two elements moves diagonally between their ways. A Lucky Cat {kitsune} moves one square any way, diagonals too. Straight moves can't pass through an oni {oniG}; diagonals slip past. Nothing may land on an oni or leave the map. Finish <b>exactly</b> on {cure}, using at least {min} hand card. Hand cards are spent; garden cards stay."
        }
      },
      "quirks": {
        "stubborn": {
          "how": "Plan for at least two ingredients of their element. A lucky cat counts as one."
        }
      }
    }
  }
