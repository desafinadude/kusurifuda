      "quest": {
        "title": "Night Train to Shibuya",
        "menu": "Night Train to Shibuya",
        "menuNew": "Ten stops from Sapporo to Shibuya",
        "done": "You reached Shibuya!",
        "stops": [
          {
            "name": "Sapporo",
            "line": "Snow and neon.",
            "story": "Snow falls on the neon crossing, and the ramen alley is full. You open a little stall under the lights; Tokyo is ten stops down the line."
          },
          {
            "name": "Hakodate",
            "line": "The night market by the harbour.",
            "story": "Squid stalls glow by the red-brick warehouses. The cases get harder here: longer routes, and symptoms on the way."
          },
          {
            "name": "Aomori",
            "line": "Giant glowing festival floats.",
            "story": "Paper warriors and dragons glow above a dancing crowd. The toolmakers come out for the festival and sell to any healer with yen."
          },
          {
            "name": "Sendai",
            "line": "Streamers in the arcade.",
            "story": "Huge paper streamers hang in the covered arcade, and the benches are full. The longer they wait, the more they need, and the more they pay."
          },
          {
            "name": "Utsunomiya",
            "line": "Dumpling alley.",
            "story": "A steamy alley of tiny dumpling shops, and rival healers who claim the customers they want."
          },
          {
            "name": "Ueno",
            "line": "Morning exercises in the park.",
            "story": "At dawn the whole park stretches together. The regulars here are generous: grateful patients bring gifts."
          },
          {
            "name": "Akihabara",
            "line": "Everybody has caught something.",
            "story": "The arcades are packed and everyone is sneezing. Every patient is contagious, and if one goes home uncured, both healers pay."
          },
          {
            "name": "Ginza",
            "line": "A VIP wants a private cure.",
            "story": "A black car pulls up outside the department store. A VIP asks you, quietly, for a cure in two stages."
          },
          {
            "name": "Shinjuku",
            "line": "Don't miss the last train.",
            "story": "Neon alleys, tangled rail lines and the last train at midnight. The bench is short and your rival keeps their cards hidden."
          },
          {
            "name": "Shibuya",
            "line": "The crossing, the end of the line.",
            "story": "The great crossing in neon rain. Your VIP is the Ramen Emperor himself, and the best healer in the city is already ahead."
          }
        ]
      },
