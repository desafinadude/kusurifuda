      "app": {
        "name": "Hogwarts",
        "title": "Hogwarts"
      },
      "title": {
        "tagline": "Potions, patients and a little mischief"
      },
      "abilities": {
        "trickster": {
          "text": "Two extra imps, and one more card to start."
        }
      },
      "label": {
        "village": "Hospital Wing",
        "villageEmpty": "The Hospital Wing is empty"
      },
      "status": {
        "hitsOni": "That path hits an imp {oni}",
        "sakura": "Snitch",
        "needElWhy": "Unicorn Hair counts as any house",
        "quirk": {
          "stubborn": "Needs two of their house"
        }
      },
      "stash": {
        "oniLeft": "Imps · {n} left"
      },
      "reward": {
        "sakura": "Snitch caught · +{n} {{mon}}"
      },
      "setup": {
        "guild": "House",
        "guildSub": "Your house crest and colour"
      },
      "rules": {
        "goal": {
          "p": "Rival healers race to {end} {{mon}}. Every patient is a small map: cure them by playing potion ingredients that move your marker from the start ◯ to the cure {cure}."
        },
        "fame": {
          "p": "A cured patient is worth its number in {{mon}}. Catching a Snitch {sakura} adds {sak}."
        },
        "curse": {
          "p": "Once per turn, after your action, you may send one of your {oni} imps to a patient to claim them. Your rival can't cure a patient you've claimed. Cure them on your next turn and you get {sak} extra {{mon}}, like a Snitch. If your next turn ends and they're still uncured, the imp goes home and your rival gets the {sak} {{mon}} instead."
        },
        "needEl": "A cure needs at least one ingredient of the patient's house (the big sign in a card's corner). Unicorn Hair {kitsune} counts as any house. A two-house card counts as either.",
        "guild": {
          "h": "Houses",
          "p": "Your house has its own ingredients. Once per brew you may play one garden card of your house twice, so plant those."
        },
        "brew": {
          "p": "Pick a patient (tap it, or swipe the map), then tap a card to preview its move. Play it, or cancel and try another. Tap a numbered chip to go back to that card. Each house moves in a straight line its own way: {dirs}, exactly as many squares as its card shows. A card with two houses moves diagonally between their ways. Unicorn Hair {kitsune} moves one square any way, diagonals too. Straight moves can't pass through an imp {oniG}; diagonals slip past. Nothing may land on an imp or leave the map. Finish <b>exactly</b> on {cure}, using at least {min} hand card. Hand cards are spent; garden cards stay."
        },
        "patients": {
          "p": "Every patient belongs to a house (the badge on their portrait). Once cured they join your <b>ward</b>, and each ward patient helps you <b>once</b>: in any brew it can <b>leap</b> 2 squares one way and 1 to the side, over anything between, or be used as a known cure."
        },
        "end": {
          "p": "Garden holds {garden}; planting into a full garden discards one. Hand limit {hand} at the end of your turn. When someone reaches {end}, the round finishes so both play equally; it also ends once the Hospital Wing is empty. Most {{mon}} wins; ties go to most cures."
        },
        "quirks": {
          "p": "Some patients have a quirk: <b>frail</b> (no diagonals or leaps), <b>nervous</b> (hand cards only), <b>stubborn</b> (two of their house) or <b>contagious</b> (if they go home uncured, both lose {cont}). Some give a gift when cured: {{mon}}, a card for your garden, an imp back, cards from the deck, or a cheaper tool. Every cured patient still joins your ward."
        },
        "bench": {
          "h": "The waiting room"
        }
      },
      "log": {
        "sakura": "+{n} for the Snitch."
      },
      "rival": {
        "noOni": "No imps",
        "oni": "Imps",
        "sakura": "+{n} Snitch",
        "echo": "played twice (house)"
      },
      "toast": {
        "goal": "Cure patients to reach {n} {{mon}}."
      },
      "guildAbility": {
        "name": "House craft"
      },
      "opts": {
        "curseSub": "It sends imps to patients it wants.",
        "oni": "Imps on the maps"
      },
